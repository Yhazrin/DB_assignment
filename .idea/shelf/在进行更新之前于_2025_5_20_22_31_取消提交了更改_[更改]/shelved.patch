<+>@import url('../style/variables.css');\r\n@import url('../components/buttons.css');\r\n@import url('../components/layout.css');\r\n@import url('../components/header.css');\r\n@import url('../style/variables.css');\r\n\r\n/* 全局背景跟 login 统一 */\r\nbody {\r\n    background: var(--bg-primary, #f5f7fa);\r\n    color: var(--text-color, #222);\r\n    font-family: 'Montserrat', 'Roboto', Arial, sans-serif;\r\n    min-height: 100vh;\r\n}\r\n\r\n\r\n/* 磨砂玻璃卡片，与login一致 */\r\n.compare-card {\r\n    width: 100%;\r\n    background: rgba(255, 255, 255, 0.68);\r\n    border-radius: var(--radius-xl, 22px);\r\n    box-shadow: 0 4px 24px rgba(120,130,170,0.09);\r\n    padding: 2.5rem 2rem 2.2rem 2rem;\r\n    -webkit-backdrop-filter: blur(15px);\r\n    backdrop-filter: blur(15px);\r\n    border: 1.5px solid #e2e5ef;\r\n    transition: box-shadow 0.25s, background 0.18s;\r\n    text-align: center;\r\n}\r\n\r\n.compare-card h2 {\r\n    font-size: 2rem;\r\n    font-weight: 700;\r\n    margin-bottom: 2rem;\r\n    color: var(--text-primary, #252b3a);\r\n    letter-spacing: 0.02em;\r\n}\r\n\r\n/* 顶部搜索栏，简洁对齐 */\r\n.compare-card > div[style*=\"margin-bottom\"] {\r\n    display: flex;\r\n    gap: 0.85rem;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-bottom: 2.3rem !important;\r\n}\r\n\r\n.compare-card input[type=\"number\"] {\r\n    border-radius: var(--radius-md, 13px);\r\n    border: 1.5px solid #e1e6ef;\r\n    padding: 0.74rem 1.2rem;\r\n    font-size: 1.05rem;\r\n    color: var(--text-color, #222);\r\n    background: rgba(248, 250, 255, 0.92);\r\n    box-shadow: none;\r\n    transition: border-color 0.22s, box-shadow 0.22s;\r\n    outline: none;\r\n}\r\n.compare-card input[type=\"number\"]:focus {\r\n    border-color: var(--primary-color, #4b6cb7);\r\n    background: #fff;\r\n}\r\n\r\n/* 统一按钮风格 - 纯色、圆角、阴影 */\r\n.compare-card .btn,\r\n.compare-card button {\r\n    background: var(--primary-color, #4b6cb7);\r\n    color: #fff;\r\n    border-radius: var(--radius-md, 13px);\r\n    font-size: 1.06rem;\r\n    font-weight: 600;\r\n    padding: 0.72rem 1.6rem;\r\n    border: none;\r\n    box-shadow: 0 2px 8px rgba(120,130,170,0.09);\r\n    cursor: pointer;\r\n    transition: background 0.18s, box-shadow 0.18s, transform 0.14s;\r\n    margin-right: 0.12rem;\r\n}\r\n.compare-card .btn:hover,\r\n.compare-card button:hover {\r\n    background: var(--secondary-color, #5a9cf7);\r\n    box-shadow: 0 8px 30px rgba(90,140,220,0.10);\r\n    transform: translateY(-2px) scale(1.03);\r\n}\r\n\r\n/* ————— 表格极简分割风格 ————— */\r\n.compare-table {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0 0.4rem;  /* 行间距 */\r\n    margin: 0.5rem 0 0 0;\r\n    background: transparent;\r\n    box-shadow: none;\r\n}\r\n\r\n.compare-table th,\r\n.compare-table td {\r\n    padding: 0.73rem 1.15rem;\r\n    background: none;\r\n    border: none;\r\n    font-size: 1.05rem;\r\n    color: var(--text-color, #23272f);\r\n    text-align: left;\r\n    font-family: inherit;\r\n    vertical-align: middle;\r\n    transition: background 0.18s;\r\n}\r\n\r\n/* 行分割线只显示于下方（非最后一行） */\r\n.compare-table tr:not(:last-child) {\r\n    border-bottom: 1.1px solid #e7e9f1;\r\n}\r\n\r\n.compare-table th {\r\n    font-weight: 700;\r\n    color: #3457b0;\r\n    background: none;\r\n    padding-bottom: 0.52rem;\r\n}\r\n\r\n/* 第一列（spec）文字稍重色 */\r\n.compare-table td.spec-label {\r\n    font-weight: 600;\r\n    color: #4162ab;\r\n    background: none;\r\n    padding-right: 1.6rem;\r\n}\r\n\r\n.compare-table td.phone-info {\r\n    color: #222;\r\n    font-weight: 400;\r\n    background: none;\r\n}\r\n\r\n/* 鼠标悬浮轻微变色 */\r\n.compare-table tr:hover td {\r\n    background: rgba(238,243,255,0.32);\r\n}\r\n\r\n/* 空数据提示 */\r\n#compareResult > div {\r\n    color: #b6bac8;\r\n    font-size: 1.09rem;\r\n    letter-spacing: 0.02em;\r\n    margin-top: 2rem;\r\n}\r\n\r\n/* 响应式适配 */\r\n@media (max-width: 900px) {\r\n    .main-container {\r\n        max-width: 98vw;\r\n        padding: 0 0.4rem;\r\n    }\r\n    .compare-card {\r\n        padding: 1.25rem 0.4rem;\r\n    }\r\n    .compare-table th, .compare-table td {\r\n        padding: 0.47rem 0.44rem;\r\n        font-size: 0.96rem;\r\n    }\r\n}\r\n@media (max-width: 540px) {\r\n    .compare-table th, .compare-table td {\r\n        font-size: 0.91rem;\r\n        padding: 0.27rem 0.17rem;\r\n    }\r\n    .compare-card h2 {\r\n        font-size: 1.12rem;\r\n    }\r\n}\r\n\r\n
